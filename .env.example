# Compose inputs: copy to ignored .env.sqlserver and fill locally.
# Leave ACCEPT_EULA empty until you explicitly accept the SQL Server Developer license.
ACCEPT_EULA=
MSSQL_SA_PASSWORD=
# Separate 16–128-character ASCII letters/digits/_/- password; include upper/lowercase and digits.
CBS_APP_PASSWORD=
SQLSERVER_PORT=14333
# trustServerCertificate=true is an explicit loopback development exception, not production TLS validation.
# Reference only. Spring Boot does not automatically load this file.
# Export variables in your shell or configure your IDE environment.
DB_URL=jdbc:sqlserver://127.0.0.1:14333;databaseName=cbs_dev;encrypt=true;trustServerCertificate=true
DB_USERNAME=cbs_app
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
JWT_ISSUER_URI=
