# Compose inputs: copy to ignored .env.sqlserver and fill locally.
# Leave ACCEPT_EULA empty until you explicitly accept the SQL Server Developer license.
ACCEPT_EULA=
MSSQL_SA_PASSWORD=
# Separate 16–128-character ASCII letters/digits/_/- password; include upper/lowercase and digits.
CBS_APP_PASSWORD=
SQLSERVER_PORT=14333
# trustServerCertificate=true is an explicit loopback development exception, not production TLS validation.
# Reference only. Spring Boot does not automatically load this file.
# Export variables in your shell or configure your IDE environment.
DB_URL=jdbc:sqlserver://127.0.0.1:14333;databaseName=cbs_dev;encrypt=true;trustServerCertificate=true
DB_USERNAME=cbs_app
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
JWT_ISSUER_URI=

# CBS11: opt in to validated policy loading and durable credit. Accounts are provisioned separately.
EXECUTION_POLICY_ENABLED=false
EXECUTION_IRR_FUNDING_ACCOUNT_ID=
EXECUTION_IRR_FUNDING_POLICY_VERSION=
# Optional Spring configuration overrides; defaults are execution-v1, IRR and the accepted caps.
BALANCE_EXECUTION_VERSION=execution-v1
BALANCE_EXECUTION_SUPPORTEDCURRENCIES=IRR
BALANCE_EXECUTION_MAXTRANSACTIONAMOUNT=10000000000000
BALANCE_EXECUTION_MAXCUSTOMERBALANCE=10000000000000

# CBS08: explicitly export these for Maven; the harness never falls back to DB_*.
SQLSERVER_TEST_URL=jdbc:sqlserver://127.0.0.1:14333;databaseName=cbs_test;encrypt=true;trustServerCertificate=true
SQLSERVER_TEST_USERNAME=cbs_app
SQLSERVER_TEST_PASSWORD=

# CBS09 local infrastructure identities. Separate secrets, same restricted character rules as CBS_APP_PASSWORD.
CBS_MIGRATOR_PASSWORD=
CBS_INITIALIZER_PASSWORD=
# Explicit deployment command only; never fall back to runtime DB_* or pass secrets as Maven -D properties.
MIGRATION_DB_URL=jdbc:sqlserver://127.0.0.1:14333;databaseName=cbs_dev;encrypt=true;trustServerCertificate=true
MIGRATION_DB_USERNAME=cbs_migrator
MIGRATION_DB_PASSWORD=
# Additional explicit test identities; both URLs must connect to cbs_test.
SQLSERVER_MIGRATION_TEST_URL=jdbc:sqlserver://127.0.0.1:14333;databaseName=cbs_test;encrypt=true;trustServerCertificate=true
SQLSERVER_MIGRATION_TEST_USERNAME=cbs_migrator
SQLSERVER_MIGRATION_TEST_PASSWORD=
SQLSERVER_INITIALIZER_TEST_URL=jdbc:sqlserver://127.0.0.1:14333;databaseName=cbs_test;encrypt=true;trustServerCertificate=true
SQLSERVER_INITIALIZER_TEST_USERNAME=cbs_initializer
SQLSERVER_INITIALIZER_TEST_PASSWORD=

# CBS15 mutation recovery. Validated ranges: attempts 1-10, budget 10000-120000 ms, backoff 0-1000 ms.
BALANCE_RETRY_MAX_ATTEMPTS=3
BALANCE_RETRY_BUDGET_MILLIS=20000
BALANCE_RETRY_BACKOFF_MILLIS=50
